# ========================================
# VARIÁVEIS DE AMBIENTE
# ========================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3000

# Chave secreta para JWT (ALTERAR EM PRODUÇÃO!)
# Use uma chave forte e aleatória
JWT_SECRET=sua_chave_secreta_muito_segura_e_longa_aqui

# Token expira em (formato: 7d, 24h, 60m, etc)
JWT_EXPIRE=7d

# Ambiente (development, production, testing)
NODE_ENV=development

# Banco de dados (futura integração)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_NAME=seu_banco